# DoLado — Variáveis de ambiente
# Copiar este ficheiro para .env.local e preencher com os valores reais.
# .env.local nunca deve ser commitado (ver .gitignore).

# Supabase — projecto "DoLado", organização "dolado-startup", região eu-west-3 (Paris)
# Dashboard: https://app.supabase.com -> Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key — só usar no servidor (nunca expor ao cliente/browser).
# Necessária para operações do backoffice que precisem de contornar RLS.
SUPABASE_SECRET_KEY=

# Brevo — email transaccional (necessário a partir da Fase 4)
# Dashboard: https://app.brevo.com -> SMTP & API -> API Keys
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# Resend — SÓ receção das respostas das empresas (respostas.dolado.pt,
# evento email.received). Os envios de e-mail continuam todos na Brevo.
# API key (só leitura dos e-mails recebidos): https://resend.com/api-keys
RESEND_API_KEY=
# Segredo de assinatura do webhook (whsec_...): Resend → Webhooks → o
# webhook criado → "Signing secret".
RESEND_WEBHOOK_SECRET=
# Domínio dos endereços dos casos (opcional; por omissão respostas.dolado.pt).
RESPOSTAS_DOMINIO=

# URL pública do site (usada em redirects de auth e emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Claude API — extração da data de fim de promoção a partir do contrato
# anexado (Fase 4). Ainda por contratar (previsto 01/10/2026) — enquanto
# vazia, o formulário de "Alerta de fim de promoção" cai sempre para o
# preenchimento manual, sem erro visível ao cliente.
ANTHROPIC_API_KEY=
# Modelo usado na extração de documentos (opcional; por omissão
# claude-sonnet-5-5). Permite trocar de modelo sem alterar código.
ANTHROPIC_DOCUMENT_MODEL=
# Sugestão do texto da reclamação pela IA: só corre com RASCUNHO_IA_ATIVO=1.
RASCUNHO_IA_ATIVO=
ANTHROPIC_RASCUNHO_MODEL=
# Análise preliminar das respostas das empresas: só corre com
# ANALISE_RESPOSTA_IA_ATIVO=1 (desligada por omissão). Modelo opcional.
ANALISE_RESPOSTA_IA_ATIVO=
ANTHROPIC_ANALISE_MODEL=

# Stripe — pagamentos do canal B2C directo (planos Avulso e Assinatura).
# Decisão de 25/09/2026. Usar sempre chaves de TESTE (sk_test_.../whsec de
# um endpoint de teste) até o fluxo estar validado ponta a ponta — só
# trocar para chaves live com confirmação explícita de Thiago. Não cobre
# o piloto Remax (parceria gratuita, fica de fora deste mecanismo).
# Dashboard: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_AVULSO_ID=
STRIPE_PRICE_ASSINATURA_ID=
# Caso Extra (11,99 €, pagamento único, só subscritores do Caso + Proteção
# sem casos disponíveis). Vazio = oferta desligada (fica o Avulso).
STRIPE_PRICE_CASO_EXTRA_ID=
